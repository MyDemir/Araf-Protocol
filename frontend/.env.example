# For an explanation of every variable, see docs/EN/ENV.md.
# ─── Araf Protocol Frontend Environment Variables ─────────────────────
# Copy this file to frontend/.env and replace placeholder values.
# Vite exposes only VITE_* variables to the browser bundle, and every VITE_* value is PUBLIC:
# never put API keys, private keys, secrets or database URLs here.
# This list is the complete set read by frontend/src (import.meta.env.VITE_*).

# ─── Backend API ───────────────────────────────────────────────────────
# Development empty fallback: http://localhost:4000/api
# Production empty fallback: /api same-origin rewrite/proxy (frontend/vercel.json)
# An absolute VITE_API_URL in a production build is rejected (frontend/src/app/apiConfig.js).
# LOCAL DEVELOPMENT ONLY: do NOT define VITE_API_URL in production/testnet builds (Vercel). apiConfig.js rejects an
# absolute URL in production; leave it unset there so the same-origin /api rewrite (frontend/vercel.json) is used.
VITE_API_URL=http://localhost:4000

# ─── Dev UI Lab / Scenario Controller ─────────────────────────────────
# true enables the UI Lab scenario controller explicitly, including preview/production-mode builds.
# Leave false for public production deployments.
VITE_ENABLE_UI_LAB=false

# ─── Escrow + supported token addresses ───────────────────────────────
# Use values from contracts/deployments/<network>.json (deploy.js also writes these three keys into
# frontend/.env automatically, but only on local networks).
# Base Sepolia chainId: 84532
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_USDT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Rewards contracts (mirror/read-only integration) ─────────────────
# Use values from contracts/deployments/<network>-rewards.json (written by contracts/scripts/deployRewards.js).
VITE_REVENUE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
# The only name is VITE_REVENUE_VAULT_ADDRESS. The legacy VITE_REWARDS_VAULT_ADDRESS is deprecated: it is still
# read (with a console.warn) only when VITE_REVENUE_VAULT_ADDRESS is empty. Do not use it.

# ─── Target chain (build-time) ─────────────────────────────────────────
# [TR] Production build'in bağlanacağı zincir: base (varsayılan) | base-sepolia (herkese açık testnet sitesi, chainId 84532).
#      Bilinmeyen değer konsola uyarı yazar ve base'e düşer. Dev modda etkisizdir (tüm zincirler açık).
#      Mint/faucet production build'lerde (testnet dahil) kapalı kalır.
# [EN] Chain the production build connects to: base (default) | base-sepolia (public testnet site, chainId 84532).
#      Unknown values log a console warning and fall back to base. Ignored in dev mode (all chains enabled).
#      Mint/faucet stays disabled in production builds (testnet included).
# VITE_TARGET_CHAIN=base

# ─── Optional RPC endpoint ─────────────────────────────────────────────
# Primary RPC for Base (production) / Base Sepolia (development). The public RPC stays as fallback.
# Leave empty to use only the rate-limited public endpoint. Invalid (non http/https) values are ignored.
VITE_RPC_URL=

# ─── Optional social links ──────────────────────────────────────
# VITE_SOCIAL_GITHUB defaults to the project repository; the other two are hidden when empty.
# VITE_SOCIAL_GITHUB=https://github.com/MyDemir/Araf-Protocol
# VITE_SOCIAL_TWITTER=
# VITE_SOCIAL_FARCASTER=
