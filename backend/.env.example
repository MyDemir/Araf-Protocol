# Tüm değişkenlerin açıklaması için docs/TR/ENV.md dosyasına bakın.
# Araf Protocol — backend/.env.example
# Bu dosya yalnız bir ŞABLONDUR; gerçek değer/secret koymayın. backend/.env olarak kopyalayın.
# Kaynak: backend/scripts altındaki process.env kullanımları (tam liste: docs/TR/DEPLOYMENT_GUIDE.md §6).
# Satırı "#" ile kapalı olan değişkenler OPSİYONELDİR; gösterilen değer koddaki varsayılandır.
# Production'da zorunlu olanlar [PROD ZORUNLU] ile işaretlidir.

# ─── Server ──────────────────────────────────────────────
PORT=4000
# production'da fly.toml zaten NODE_ENV=production verir. production'da KMS_PROVIDER=env (yalnız Base Sepolia istisnası hariç, bkz. Encryption bölümü), localhost origin ve
# SIWE_DOMAIN=localhost kabul edilmez; Redis TLS zorunludur.
NODE_ENV=development
# Log dizini (varsayılan: backend/logs, dosya araf.log)
# LOG_DIR=

# ─── MongoDB ─────────────────────────────────────────────
# [PROD ZORUNLU] Uygulama ve migration'lar MONGODB_URI okur. MONGO_URI kullanımdan kalktı (migration'larda yalnız uyarılı yedek).
MONGODB_URI=mongodb://127.0.0.1:27017/araf_protocol

# ─── Redis ───────────────────────────────────────────────
# [PROD ZORUNLU] production'da rediss:// ya da REDIS_TLS=true gerekir.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_TLS=false
# Yalnız self-signed geliştirme Redis'i için; production'da true olursa backend başlamaz.
# REDIS_TLS_SKIP_VERIFY=false
# REDIS_READY_WAIT_MS=5000

# ─── JWT ─────────────────────────────────────────────────
# [ZORUNLU — HER ORTAMDA, dev dahil] Yoksa/kısaysa backend başlamaz (modül yüklenirken fail-fast; /ready de ister).
# Minimum 64 karakter (512-bit); entropy (>=3.5) kontrolü yapılır, placeholder reddedilir.
# [EN] Required in EVERY environment; the process exits at load if missing, <64 chars, low-entropy or a placeholder.
# Yerelde `npm run init:env` bunu otomatik üretir. Elle üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=BURAYA_CRYPTO_RANDOM_BYTES_64_ILE_URETILMIS_HEX_YAPISTIRINIZ
JWT_EXPIRES_IN=15m
# Trade-scoped PII token süresi
PII_TOKEN_EXPIRES_IN=15m
# Redis blacklist okuma zaman aşımı ve hata modu (closed: istek reddedilir; production varsayılanı closed, diğer open)
# JWT_BLACKLIST_TIMEOUT_MS=1500
# JWT_BLACKLIST_FAIL_MODE=closed
# Refresh oturumu: mutlak ömür (sn), iki-sekme yarış toleransı (ms), eski oturumlar için tek seferlik SCAN
# (deploy'dan ~7 gün sonra false yapılabilir)
# REFRESH_ABSOLUTE_TTL_SECS=2592000
# REFRESH_REUSE_GRACE_MS=10000
# REFRESH_LEGACY_SCAN=true

# ─── SIWE ────────────────────────────────────────────────
# [PROD ZORUNLU] SIWE_DOMAIN localhost olamaz (https:// olmadan, yalnız host); SIWE_URI https olmalı ve
# host'u SIWE_DOMAIN ile aynı olmalıdır. Örn: SIWE_DOMAIN=app.araf.xyz  SIWE_URI=https://app.araf.xyz
SIWE_DOMAIN=localhost
# SIWE_URI=https://app.araf.xyz

# ─── CORS ────────────────────────────────────────────────
# [PROD ZORUNLU] Virgülle ayrılmış origin listesi; her biri http(s):// ile başlar, path/query içermez.
# Wildcard (*) ve tek başına localhost fallback production'da engellenir: NODE_ENV=production iken liste yalnız
# localhost/127.0.0.1 origin'lerinden oluşuyorsa süreç AÇILIŞTA durur (fail-fast). Gerçek frontend origin'ini yazın.
# [EN] In production, an origin list containing only localhost aborts startup.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Encryption (KMS / Envelope) ─────────────────────────
# Production'da KMS_PROVIDER='env' kullanılamaz; TEK İSTİSNA Base Sepolia testnet demosudur (aşağıya bakın:
# NODE_ENV=production + EXPECTED_CHAIN_ID=84532 + ALLOW_ENV_KMS_ON_TESTNET=yes + RPC'nin 84532 olduğunun doğrulanması; mainnet'te asla).
#
# Development (yerel test):
#   KMS_PROVIDER=env
#   MASTER_ENCRYPTION_KEY=<64 hex karakter>   (ilk 64 karakter okunur)
#   Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Production (AWS KMS — önerilen):
#   KMS_PROVIDER=aws
#   AWS_ENCRYPTED_DATA_KEY=<base64 CiphertextBlob>   (zorunlu)
#   AWS_REGION=eu-west-1                              (varsayılan eu-west-1)
#   (AWS_KMS_KEY_ARN gerekmez ve tanımlamayın: anahtar kimliği CiphertextBlob içindedir.)
#
# Production (HashiCorp Vault Transit — alternatif):
#   KMS_PROVIDER=vault
#   VAULT_ADDR=https://vault.example.com:8200   (zorunlu)
#   VAULT_TOKEN=<vault-token>                   (zorunlu)
#   VAULT_KEY_NAME=araf-master-key              (varsayılan araf-master-key)
#   VAULT_ENCRYPTED_DATA_KEY=vault:v1:<...>     (zorunlu: SABİT wrapped data key; yoksa fail-closed)
# SADECE Base Sepolia testnet demosu için dar istisna (SEC-01): NODE_ENV=production + EXPECTED_CHAIN_ID=84532
# + ALLOW_ENV_KMS_ON_TESTNET=yes üçü birlikte gerekir; her başlatmada büyük uyarı loglanır. Mainnet'te ETKİSİZDİR
# (8453'te yes verilse bile başlatma hata verir). Gerçek PII girmeyin.
# ALLOW_ENV_KMS_ON_TESTNET=
KMS_PROVIDER=env
MASTER_ENCRYPTION_KEY=BURAYA_CRYPTO_RANDOM_BYTES_32_ILE_URETILMIS_HEX_YAPISTIRINIZ

# ─── Base Network ────────────────────────────────────────
# [PROD ZORUNLU] Public fallback yoktur; explicit provider URL girilmelidir.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# [PROD ZORUNLU] Backend provider fail-closed chain doğrulaması (8453 = Base, 84532 = Base Sepolia).
# YEREL GELİŞTİRME: BASE_RPC_URL'iniz yerel hardhat düğümüne (http://127.0.0.1:8545) bakıyorsa EXPECTED_CHAIN_ID=31337
# yapın; örnekteki 8453 ile uyuşmazlık hatası alırsınız. Örnek değer 8453 kalır (prod şablonu).
# BASE_RPC_URL tanımlıysa development'ta da zorunludur (yalnız yerel hızlı deneme için
# ALLOW_UNSAFE_CHAIN_ID_BYPASS=true ile atlanabilir; production'da bypass yoktur).
EXPECTED_CHAIN_ID=8453
# ALLOW_UNSAFE_CHAIN_ID_BYPASS=false
# WebSocket RPC — gerçek zamanlı event dinleme için önerilir (wss://). Tanımsızsa HTTP RPC kullanılır.
# BASE_WS_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── Kontrat adresleri ───────────────────────────────────
# [PROD ZORUNLU] ArafEscrow adresi (contracts/deployments/<network>.json -> escrowAddress)
ARAF_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Kanonik token env'leri (chain-aware). EXPECTED_CHAIN_ID=8453 için BASE_MAINNET_*, 84532 için BASE_SEPOLIA_*.
# ARAF_TRACKED_TOKENS boşsa izlenen token seti bu çiftten türetilir; production'da zero address kabul edilmez.
BASE_MAINNET_USDT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_MAINNET_USDC_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_USDT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_USDC_ADDRESS=0x0000000000000000000000000000000000000000
# İzlenecek token seti (opsiyonel, virgülle ayrılmış). Verilirse yukarıdaki çiftlerden önceliklidir.
# ARAF_TRACKED_TOKENS=0x<usdt>,0x<usdc>
# Legacy alias'lar (yalnız geriye uyum; production'da önerilmez): MAINNET_USDT_ADDRESS / MAINNET_USDC_ADDRESS
# (yalnız 8453) ve development'ta USDT_ADDRESS / USDC_ADDRESS.
# Deploy script env'leri (TREASURY_ADDRESS, FINAL_OWNER_ADDRESS, EXTERNAL_*, DEPLOYER_PRIVATE_KEY ...)
# backend'de OKUNMAZ; bunlar contracts/.env içindir.

# ─── Event worker ────────────────────────────────────────
# [PROD ZORUNLU] İlk açılışta Redis'te checkpoint yoksa başlangıç bloğu: ARAF_DEPLOYMENT_BLOCK (öncelikli)
# ya da WORKER_START_BLOCK. Checkpoint varsa gerekmez. Production'da ikisi de yoksa VE checkpoint de yoksa
# event worker hata fırlatır ve başlamaz (fail-fast). [EN] Prod worker throws without a start block or checkpoint.
# ARAF_DEPLOYMENT_BLOCK=
# WORKER_START_BLOCK=
# true ise worker hiç başlatılmaz (yalnız API modu)
# WORKER_DISABLED=false
# Safe checkpoint için blok derinliği (production varsayılanı 6, diğer 1)
# WORKER_FINALITY_DEPTH=6
# WORKER_BLOCK_BATCH_SIZE=1000
# WORKER_CHECKPOINT_INTERVAL_BLOCKS=50
# Replay hata backoff'u (ms): taban ve tavan
# WORKER_REPLAY_BACKOFF_BASE_MS=5000
# WORKER_REPLAY_BACKOFF_MAX_MS=300000
# Watchdog: bu kadar ms yeni blok görülmezse reconnect; hâlâ yoksa süreç çıkar
# WORKER_BLOCK_STALE_MS=75000
# WORKER_WATCHDOG_INTERVAL_MS=15000
# /health liveness eşiği (ms): aşılırsa 503 "stale" (varsayılan: WORKER_BLOCK_STALE_MS*2 + 30000)
# WORKER_LIVENESS_STALE_MS=180000
# /ready için en büyük kabul edilen blok gecikmesi
# WORKER_MAX_LAG_BLOCKS=25

# ─── Health / ready ──────────────────────────────────────
# /ready'nin tam (redakte edilmemiş) gövdesi için x-internal-token header değeri. Boşsa kapalıdır.
# Uzun rastgele bir değer üretin; repo'ya koymayın.
# READY_INTERNAL_TOKEN=
# /ready önbellek süresi (ms; 5000-10000 aralığına sıkıştırılır)
# READY_CACHE_TTL_MS=7000

# ─── Relayer (Reputation Decay + Reward Outcome Recorder) ─
# reputationDecay.js (decayReputation) ve rewardOutcomeRecorder.js (ArafRewards.recordTradeOutcomes) için.
# İkisi de permissionless tetikleyicidir; ağırlık/eligibility kontrattan türetilir. Fon hareketi yapamaz.
# Tanımsızsa bu iki görev "çalıştırılamıyor" logu bırakıp pasif kalır. Ayrı, düşük bakiyeli bir cüzdan kullanın.
# OPSİYONEL: boş bırakılırsa decay/reward recorder görevleri pasif kalır (backend yine açılır). Geçersiz bir değer (örn. bu
# placeholder) açılışı çökertmez ama her görev turunda hata loglar; ya gerçek anahtarı girin ya da boş bırakın (init:env boş yazar).
# [EN] Optional; empty = relayer jobs passive. Never generated by init:env — you supply a real key.
# Üretmek için: node -e "const {ethers}=require('ethers'); console.log(ethers.Wallet.createRandom().privateKey)"
RELAYER_PRIVATE_KEY=0x_BURAYA_AYRI_BIR_CUZDAN_ANAHTARI_EKLE
# REPUTATION_DECAY_CANDIDATE_LIMIT=250
# REPUTATION_DECAY_TX_LIMIT=50
# REWARD_RECORDER_CANDIDATE_LIMIT=200
# REWARD_RECORDER_BATCH_LIMIT=50

# ─── Admin (read-only gözlem paneli) ─────────────────────
# /api/admin/* ve /api/auth/me isAdmin yalnız bu cüzdanlara açıktır (virgülle ayrılmış). Boşsa kimse admin değildir.
ADMIN_WALLETS=

# ─── Rewards wiring (mirror) ─────────────────────────────
# Event worker bu adreslerden EscrowRevenueReceived / ExternalRewardFunded / ProductRewardFunded /
# EpochRewardAllocated / RewardClaimed event'lerini okur. Boş/sıfır bırakılırsa reward mirror boş kalır
# ve rewardOutcomeRecorder pasif olur.
ARAF_REVENUE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
ARAF_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
# [TR] Aşağıdaki iki bayrak kod tarafından OKUNMAZ; backend rewards yüzeyi her zaman salt-okunur/mirror'dır.
#      Belge/regresyon testi amaçlı tutulur (test/backend/rewards.authority.readonly.regression.test.js).
# [EN] These two flags are not read by code; the rewards surface is always read-only/mirror.
REWARDS_READ_ONLY=true
REWARDS_SOURCE=ONCHAIN_MIRROR

# ─── Identity normalization guard ────────────────────────
# Mixed numeric on-chain id kaydı varsa: off | warn | enforce. Varsayılan: production'da enforce, diğer warn.
# Çözüm: npm run migrate:identity (önce migrate:identity:dry).
# IDENTITY_NORMALIZATION_GUARD=enforce
# PII route'ları için ayrı mod (varsayılan: IDENTITY_NORMALIZATION_GUARD, o da yoksa enforce)
# PII_IDENTITY_NORMALIZATION_GUARD=enforce
# migrate:identity batch boyutu
# IDENTITY_MIGRATION_BATCH_SIZE=1000

# ─── Zamanlanmış işler (ms; yalnız pozitif tamsayı, aksi halde varsayılan) ─
# JOB_DLQ_INTERVAL_MS=60000
# JOB_REPUTATION_DECAY_DELAY_MS=30000
# JOB_REPUTATION_DECAY_INTERVAL_MS=86400000
# JOB_REWARD_RECORDER_INTERVAL_MS=3600000
# JOB_STATS_SNAPSHOT_DELAY_MS=60000
# JOB_STATS_SNAPSHOT_INTERVAL_MS=86400000
# JOB_SENSITIVE_CLEANUP_DELAY_MS=120000
# JOB_SENSITIVE_CLEANUP_INTERVAL_MS=1800000
# JOB_USER_BANK_RISK_CLEANUP_DELAY_MS=150000
# JOB_USER_BANK_RISK_CLEANUP_INTERVAL_MS=21600000
# Reconciliation raporu: production'da varsayılan açık (false ile kapanır), diğer ortamlarda varsayılan kapalı
# JOB_RECONCILIATION_ENABLED=true
# JOB_RECONCILIATION_INTERVAL_MS=600000
# USER_BANK_RISK_CLEANUP_CURSOR_BATCH_SIZE=200

# ─── Önbellek / limit / referans kur ─────────────────────
# Protokol config mirror önbelleği (sn)
# CONFIG_CACHE_TTL_SECONDS=3600
# GET /api/orders yanıt önbelleği (ms; 0 kapatır)
# MARKET_CACHE_TTL_MS=10000
# Rate limiter tier önbelleği (sn)
# RATE_LIMIT_TIER_CACHE_TTL_SECONDS=120
# Referans kur şeridi (bilgilendirme amaçlı; settlement'ı etkilemez)
# REFERENCE_TICKER_REFRESH_INTERVAL_MS=120000
# REFERENCE_TICKER_CRYPTO_TTL_SECONDS=120
# REFERENCE_TICKER_FIAT_TTL_SECONDS=21600
# REFERENCE_TICKER_LAST_GOOD_TTL_SECONDS=604800
# Bu süreden eski satırlar son-iyi önbellekten de düşer (sn)
# REFERENCE_TICKER_MAX_STALE_SECONDS=86400
