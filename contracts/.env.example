# For an explanation of every variable, see docs/ENV.md.
# ─── Araf Protocol Contracts Environment Variables ────────────────────
# Copy this file to contracts/.env and replace placeholder values.
# Hardhat loads this file through dotenv from contracts/hardhat.config.js.
# Source of truth: contracts/hardhat.config.js and contracts/scripts/*.js (process.env usage).
# The network is chosen with `--network <name>` (hardhat | localhost | base-sepolia | base), not with an env var.

# ─── Network / signer ─────────────────────────────────────────────────
# Base Sepolia chainId: 84532
# Base Mainnet chainId: 8453
# Hardhat fails closed: `--network base` needs BASE_RPC_URL, `--network base-sepolia` needs BASE_SEPOLIA_RPC_URL.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# Required for public networks; never commit a real key. Not used on hardhat/localhost.
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=
REPORT_GAS=false
# CMC_API_KEY=

# ─── Optional solc-js fallback ─────────────────────────────────────────
# For network-restricted environments where the native solc 0.8.24 cannot be downloaded: path to the
# soljson.js of the solc@0.8.24 package. No-op when unset.
# ARAF_SOLCJS_PATH=

# ─── Public deploy guard ───────────────────────────────────────────────
# Required for public-chain escrow deploys: base-sepolia and base.
CONFIRM_PUBLIC_DEPLOY=no

# ─── Escrow deploy/configuration ───────────────────────────────────────
# contracts/scripts/deploy.js requires TREASURY_ADDRESS for all deploys.
# Public/custom deploys also require FINAL_OWNER_ADDRESS and it must differ from TREASURY_ADDRESS
# (on local networks it defaults to TREASURY_ADDRESS).
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
FINAL_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Base Sepolia escrow deploy token config. Required when deploying to base-sepolia.
# deploy.js rejects MAINNET_* aliases on Base Sepolia; use these names exactly.
BASE_SEPOLIA_USDT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Base Mainnet escrow deploy token config. Required when deploying to base.
# (Legacy MAINNET_USDT_ADDRESS / MAINNET_USDC_ADDRESS aliases are still accepted for Base Mainnet only.)
BASE_MAINNET_USDT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_MAINNET_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Local/custom only: use external token addresses instead of deploying MockERC20.
USE_EXTERNAL_TOKEN_ADDRESSES=false
EXTERNAL_USDT_ADDRESS=0x0000000000000000000000000000000000000000
EXTERNAL_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Existing escrow / rewards deployment ─────────────────────────────
# Required by deployRewards.js on public networks (the escrow must already exist); optional on local,
# where a missing value deploys a fresh linked escrow (needs TREASURY_ADDRESS).
ARAF_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Required by deployRewards.js on public networks; optional on local (defaults to the deployer).
FINAL_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
CONFIRM_FRESH_ESCROW_DEPLOY=no
# Needed only to overwrite critical addresses of an existing deployments/<network>-rewards.json.
CONFIRM_OVERWRITE_REWARDS_MANIFEST=no

# ─── Rewards configuration / smoke / treasury ops ─────────────────────
# rewardsOps.js reads these from env first, then falls back to deployments/<network>-rewards.json.
ARAF_REVENUE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
ARAF_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000
# USDT_ADDRESS=
# USDC_ADDRESS=
# The operation is picked by the npm script name or by REWARDS_OP=configure|verify|switch-treasury.
# REWARDS_OP=
# [TR] REWARD_BPS ve CONFIRM_CONFIGURE_REWARDS script'ler tarafından OKUNMAZ (rewardBps kontratta 4000 başlar,
#      4000-7000 aralığındadır); belge/regresyon testi (rewards.goLive.readiness) için sabit tutulur.
# [EN] REWARD_BPS and CONFIRM_CONFIGURE_REWARDS are not read by any script; they stay as documented constants.
REWARD_BPS=4000
CONFIRM_CONFIGURE_REWARDS=false
# switch-treasury is fail-closed: needs CONFIRM_TREASURY_SWITCH=true and the current escrow treasury address.
CONFIRM_TREASURY_SWITCH=false
EXPECTED_CURRENT_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional extra check in `verify`: escrow.treasury() must equal this address.
# EXPECT_ESCROW_TREASURY_ADDRESS=
# Go-live requires rewardBps == 4000; set true only to deliberately bypass that check in switch-treasury.
# ALLOW_NON_4000_REWARD_BPS=false
CONFIRM_PUBLIC_SMOKE=no

# ─── Misc ──────────────────────────────────────────────────────────────
# Where scripts/gasBaseline.js writes its JSON table (optional).
# GAS_BASELINE_OUT=
